# Optional public RPC overrides. These are not secrets.
# Never put a seed phrase, private key, or an API key that can move funds here.
# EXPO_PUBLIC_ETH_RPC=https://ethereum-rpc.publicnode.com
# EXPO_PUBLIC_BASE_RPC=https://mainnet.base.org
# EXPO_PUBLIC_POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# EXPO_PUBLIC_ARB_RPC=https://arbitrum-one-rpc.publicnode.com
# EXPO_PUBLIC_OP_RPC=https://optimism-rpc.publicnode.com
# EXPO_PUBLIC_BNB_RPC=https://bsc-rpc.publicnode.com
# EXPO_PUBLIC_AVAX_RPC=https://avalanche-c-chain-rpc.publicnode.com
# An override is tried first. Built-in public fallbacks still run after it.

# Public WalletConnect / Reown Cloud project ID (not a private key).
# Unset, the app uses the live listing's public client ID.
# EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
