{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BUY_CRYPTO": "1",
        "EXPO_PUBLIC_TRANSAK_WIDGET_ENDPOINT": "https://boredefi-transak-api.vercel.app/api/widget-url"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BUY_CRYPTO": "1",
        "EXPO_PUBLIC_TRANSAK_WIDGET_ENDPOINT": "https://boredefi-transak-api.vercel.app/api/widget-url"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "distribution": "store",
        "resourceClass": "default"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SOLANA": "1",
        "EXPO_PUBLIC_BUY_CRYPTO": "1",
        "EXPO_PUBLIC_ONRAMP_URL": "https://pay.boredefi.com/api/onramp-session"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6829342714",
        "appleTeamId": "VSZFP52B3Q"
      }
    }
  }
}
