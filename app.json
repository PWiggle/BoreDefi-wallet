{
  "expo": {
    "name": "BoreDefi Wallet",
    "slug": "boredefi-wallet",
    "scheme": "boredefi",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "BoreDefi Wallet",
      "shortName": "BoreDefi"
    },
    "experiments": {
      "baseUrl": "/BoreDefi-wallet"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.boredefi.wallet",
      "buildNumber": "19",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a recipient address or WalletConnect QR code.",
        "NSFaceIDUsageDescription": "Unlock BoreDefi Wallet with Face ID.",
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.boredefi.wallet",
      "versionCode": 35,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#255470",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withOptionalHardware",
      "react-native-quick-crypto",
      "expo-system-ui",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      "./plugins/withUnsignedRelease",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock BoreDefi Wallet with Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a recipient address or WalletConnect QR code.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withHiddenSplashStatusBar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#255470",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "useLegacyPackaging": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.reactnativecommunity.asyncstorage.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keep class com.reactnativecommunity.netinfo.** { *; }\n-keep class com.shopify.reactnative.skia.** { *; }\n-dontwarn org.bouncycastle.**\n-dontwarn org.conscrypt.**\n-dontwarn org.slf4j.**\n-dontwarn java.awt.**\n-dontwarn javax.swing.**\n-keep class com.sun.jna.** { *; }\n-keepclassmembers class * extends com.sun.jna.** { *; }\n-keepclassmembers class com.sun.jna.Pointer { long peer; }\n-keep class uniffi.** { *; }\n-keep class com.walletconnect.** { *; }\n-keep class com.reown.** { *; }"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "owner": "peplabs",
    "extra": {
      "eas": {
        "projectId": "abd7b480-a7d9-4f16-a942-fd4c9701468d"
      }
    }
  }
}
